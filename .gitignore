# Ticket Book – safe to push to GitHub
# Do not commit: secrets, env files with credentials, build output, or IDE/OS files.
# Committed templates: backend/.env.example, .env.deploy.example (no real secrets).

# Dependencies
node_modules/

# Build output
dist/
build/

# Environment – never commit (DB URL, JWT_SECRET, SMTP, GCS_BUCKET, etc.)
.env
.env.local
.env.*.local
!.env.example
backend/.env
.env.deploy

# Database (project uses PostgreSQL; ignore SQLite leftovers)
*.db
*.db-journal
backend/prisma/*.db

# Backend
backend/node_modules/
backend/dist/
backend/uploads/

# Frontend
frontend/node_modules/
frontend/dist/

# Logs and cache
*.log
npm-debug.log*
.cache
.vite
.cursor/debug*.log

# Cursor / IDE
.cursor/

# OS
.DS_Store
Thumbs.db

# IDE (uncomment if you use these)
# .idea/
# .vscode/
# *.swp
# *.swo

# Test / coverage
coverage/
.nyc_output/

# Misc
*.tgz
.turbo
pnpm-debug.log*
.yarn/
.yarnrc.yml
.env.backup
.env.deploy.backup
