# PostgreSQL. Example for local: postgresql://user:password@localhost:5432/ticket_book
DATABASE_URL="postgresql://user:password@localhost:5432/ticket_book"
JWT_SECRET="change-me-in-production"
# JWT/session expiry. Default 7d so users stay logged in; use 20m for short sessions.
JWT_EXPIRES_IN=20m
RESERVATION_EXPIRY_MINUTES=10
PORT=3001

# Email: SMTP (e.g. Gmail — create App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
