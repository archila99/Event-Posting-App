# PostgreSQL. Example for local: postgresql://user:password@localhost:5432/ticket_book
DATABASE_URL="postgresql://user:password@localhost:5432/ticket_book"
JWT_SECRET="change-me-in-production"
# Session limit for all roles (user, artist, admin). Example: 20m, 1h, 24h
JWT_EXPIRES_IN=20m
RESERVATION_EXPIRY_MINUTES=10
PORT=3001

# Email (verification code). If not set, codes are logged to console only.
# Gmail example (use an App Password: https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com
