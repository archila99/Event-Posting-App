# Supabase Postgres (recommended for production):
# - Add ?sslmode=require
# - If using Supabase PgBouncer pooler, use the pooler connection string for DATABASE_URL
#   and put the direct connection in DIRECT_URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

NODE_ENV=development
PORT=3001
FRONTEND_URL="http://localhost:5173"
RESERVATION_EXPIRY_MINUTES=10

# Access JWT (Bearer). Prefer these names in production:
JWT_ACCESS_SECRET="change-me-in-production"
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh session (HttpOnly cookie). Prefer these names in production:
JWT_REFRESH_SECRET="change-me-refresh-different-from-access"
REFRESH_TOKEN_EXPIRES_IN=7d

# Backwards-compatible fallbacks (ok for local dev; avoid in production)
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
JWT_SECRET=""

#
# Uploads:
# Event images are stored on local disk under backend/uploads and served from /api/uploads.
# In production on many hosts (including Render), local disk is ephemeral; use an external
# storage provider if you need persistence across deploys.
