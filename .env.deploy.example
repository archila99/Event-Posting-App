# Copy to .env.deploy and set your values. .env.deploy is gitignored.
# Usage: cp .env.deploy.example .env.deploy  &&  edit .env.deploy  &&  ./deploy.sh

# ----- Required -----
export DB_PASSWORD=your-db-password
export JWT_SECRET=your-strong-random-jwt-secret-at-least-32-chars

# ----- Cloud SQL & GCP (optional; defaults shown) -----
export GCP_PROJECT=eventora-ticketing-app
export GCP_REGION=europe-west2
export CLOUD_SQL_INSTANCE=eventora-postgres
export DB_NAME=eventora_db
export DB_USER=postgres
export SERVICE_NAME=ticket-book

# ----- Optional: app behaviour (same as local defaults) -----
# export JWT_EXPIRES_IN=20m
# export RESERVATION_EXPIRY_MINUTES=10

# ----- Optional: keep one instance warm (avoids 503 on cold start) -----
# export MIN_INSTANCES=1

# ----- Email (SMTP) — required for verification emails on Cloud Run -----
# Cloud Run does not use backend/.env; set these here and redeploy so the app can send codes.
# export SMTP_HOST=smtp.gmail.com
# export SMTP_PORT=587
# export SMTP_USER=your-email@gmail.com
# export SMTP_PASS=your-app-password
# export EMAIL_FROM=your-email@gmail.com

# ----- Optional: DB setup from local (if direct IP connection fails with P1001) -----
# Use Cloud SQL Auth Proxy: set USE_PROXY=1 and install cloud_sql_proxy.
# See https://cloud.google.com/sql/docs/postgres/connect-auth-proxy
# export USE_PROXY=1
# export PROXY_PORT=5433

# ----- Event images on Cloud Run (required for images to persist) -----
# Without this, uploads go to ephemeral container storage and images disappear on redeploy.
# Create a GCS bucket, grant the Cloud Run service account Storage Object Admin, then set:
export GCS_BUCKET=eventora-bucket
# (Use your bucket name. App uses signed URLs so the bucket does not need to be public.)

# ----- Note -----
# DATABASE_URL is built by deploy.sh from GCP_* and DB_* above. Do not set DATABASE_URL here.
# PORT is set by Cloud Run (8080). First-time DB: run ./deploy-db-setup.sh before deploy.
