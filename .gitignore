# Safe to push to GitHub: secrets and build artifacts are ignored.
# Dependencies
node_modules/

# Build output
dist/
build/

# Environment (never commit secrets; DB URL and JWT_SECRET live here)
.env
.env.local
.env.*.local
!.env.example
backend/.env

# Database (SQLite leftovers; project uses PostgreSQL)
*.db
*.db-journal
backend/prisma/*.db

# Backend
backend/node_modules/
backend/dist/
backend/uploads/

# Frontend
frontend/node_modules/
frontend/dist/

# Logs and cache
*.log
npm-debug.log*
.cache
.vite

# OS
.DS_Store
Thumbs.db

# IDE (optional; uncomment to ignore)
# .idea/
# .vscode/
# *.swp
# *.swo

# Test / coverage
coverage/
.nyc_output/

# Misc
*.tgz
.turbo
pnpm-debug.log*
.yarn/
.yarnrc.yml
